From 4f56718578afe29712c9de6929aeb1186859c85d Mon Sep 17 00:00:00 2001
From: Ctrlable <ron@ctrlable.com>
Date: Wed, 18 Nov 2026 09:06:53 -0500
Subject: [ctrlable 1/1] ctrlable: platform-supported gate for
 Supervised-in-LXC (CTRLABLE_PLATFORM=lxc)

The 'os' and 'network_manager' unsupported reasons are structurally
unsatisfiable in an Incus LXC (os_agent is not HAOS; the NM-managed veth is
not enumerable over Supervisor's NM D-Bus) yet neither blocks any feature.
Ctrlable Pro owns this platform, so gate both evaluations behind an env flag
only our image sets. Inert on real HAOS (flag unset), keeping the fork
rebaseable at upstream cadence.
---
 supervisor/resolution/evaluations/network_manager.py  | 10 ++++++++++
 supervisor/resolution/evaluations/operating_system.py |  8 ++++++++
 2 files changed, 18 insertions(+)

diff --git a/supervisor/resolution/evaluations/network_manager.py b/supervisor/resolution/evaluations/network_manager.py
index 022df2a..bfb87cf 100644
--- a/supervisor/resolution/evaluations/network_manager.py
+++ b/supervisor/resolution/evaluations/network_manager.py
@@ -1,5 +1,7 @@
 """Evaluation class for network manager."""
 
+import os
+
 from ...const import CoreState
 from ...coresys import CoreSys
 from ...host.const import HostFeature
@@ -32,4 +34,12 @@ class EvaluateNetworkManager(EvaluateBase):
 
     async def evaluate(self) -> bool:
         """Run evaluation."""
+        # On Ctrlable Pro the NIC is a NetworkManager-managed veth on an Incus
+        # bridge: connectivity is full, but Supervisor cannot enumerate the veth
+        # over NM's D-Bus, so HostFeature.NETWORK is absent. We own the platform,
+        # so gate this behind the flag OUR image sets (inert on HAOS). NOTE: the
+        # Supervisor Network UI stays inert until the veth is exposed over D-Bus
+        # (tracked follow-up); host/Incus owns networking meanwhile. See SPEC §6a.
+        if os.environ.get("CTRLABLE_PLATFORM") == "lxc":
+            return False
         return HostFeature.NETWORK not in self.sys_host.features
diff --git a/supervisor/resolution/evaluations/operating_system.py b/supervisor/resolution/evaluations/operating_system.py
index cca3a25..b7c821e 100644
--- a/supervisor/resolution/evaluations/operating_system.py
+++ b/supervisor/resolution/evaluations/operating_system.py
@@ -1,5 +1,7 @@
 """Evaluation class for operating system."""
 
+import os
+
 from ...const import CoreState
 from ...coresys import CoreSys
 from ..const import UnsupportedReason
@@ -31,4 +33,10 @@ class EvaluateOperatingSystem(EvaluateBase):
 
     async def evaluate(self) -> bool:
         """Run evaluation."""
+        # Ctrlable Pro owns its platform (Supervised in an Incus LXC on Debian).
+        # `sys_os.available` is only ever true on HAOS, so on our supported
+        # appliance this reason is structurally unsatisfiable — gate it behind a
+        # flag OUR image sets, inert on real HAOS (flag unset). See SPEC §6a.
+        if os.environ.get("CTRLABLE_PLATFORM") == "lxc":
+            return False
         return not self.sys_os.available
