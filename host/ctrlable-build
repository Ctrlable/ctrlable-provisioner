#!/usr/bin/env python3
"""
ctrlable-build — runs on the PVE host, invoked via SSH command= restriction.

authorized_keys entry:
  command="/usr/local/bin/ctrlable-build",restrict,no-pty ssh-rsa AAAA...

SSH_ORIGINAL_COMMAND format:
  ctrlable-build deploy <release> <template_name> <hostname>

Deploys a single instance directly (no templates, no clone):
  - LXC: runs the community script, injects firstboot service, leaves running
  - VM:  imports the branded HAOS .img.xz, configures, starts

Config file /etc/ctrlable/build.conf (JSON):
  {
    "orchestrator_url": "http://<ip>:8000",
    "build_token": "<same as BUILD_TOKEN in orchestrator .env>",
    "haos_image_path": "/opt/ctrlable/images/ctrlable-pro-os-generic-x86-64-<ver>.img.xz"
  }
"""

import ipaddress
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.request
from pathlib import Path


# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

def log(msg: str) -> None:
    print(msg, flush=True)


def die(msg: str) -> None:
    log(f"[ERROR] {msg}")
    sys.exit(1)


# Deploys are long and mostly silent (a 551 MB decompress, then a community
# script that prints its own spinner). The orchestrator parses these markers to
# drive a progress bar, so the count must stay honest: emit every phase exactly
# once, in order, and keep the total equal to the number a path really has.
PHASE_TOTAL = 6

# The template whose internal address the MQTT broker lives at — the HAOS VM.
# Must match backend/app/internal_net.py:BROKER_TEMPLATE.
BROKER_TEMPLATE = "ctrlable-pro"


def phase(n: int, label: str) -> None:
    log(f"[PHASE] {n}/{PHASE_TOTAL} {label}")


# ---------------------------------------------------------------------------
# Args + config
# ---------------------------------------------------------------------------

def parse_args() -> tuple[str, str, str | None, str | None]:
    """Return (action, release, template_name, hostname) from SSH_ORIGINAL_COMMAND."""
    original = os.environ.get("SSH_ORIGINAL_COMMAND", "")
    parts = original.split()
    if len(parts) == 5 and parts[0] == "ctrlable-build" and parts[1] == "deploy":
        return "deploy", parts[2], parts[3], parts[4]
    # migrate-internal <release> <template> <vmid> — move an already-deployed LXC
    # service onto the internal LAN in place (attach net1, re-home its app). The
    # vmid rides in the hostname slot.
    if len(parts) == 5 and parts[0] == "ctrlable-build" and parts[1] == "migrate-internal":
        return "migrate-internal", parts[2], parts[3], parts[4]
    if len(parts) == 3 and parts[0] == "ctrlable-build" and parts[1] == "preflight":
        return "preflight", parts[2], None, None
    # enable-internal-net <release> [ha_vmid] — bring the internal LAN up on an
    # already-deployed host (ha_vmid rides in the template_name slot).
    if len(parts) in (3, 4) and parts[0] == "ctrlable-build" \
            and parts[1] == "enable-internal-net":
        return "enable-internal-net", parts[2], (parts[3] if len(parts) == 4 else None), None
    if len(parts) == 2 and parts[0] == "ctrlable-build" and parts[1] == "update-host-tools":
        return "update-host-tools", None, None, None
    # list-serial-devices — read-only inventory of /dev/serial/by-id sticks.
    if len(parts) == 2 and parts[0] == "ctrlable-build" and parts[1] == "list-serial-devices":
        return "list-serial-devices", None, None, None
    # attach-device / detach-device <vmid> <by-id> — bind/unbind a USB serial
    # coordinator to an LXC by its stable by-id. vmid rides the release slot,
    # by-id the template slot. by-id has no spaces, so a 4-token split is exact.
    if len(parts) == 4 and parts[0] == "ctrlable-build" \
            and parts[1] in ("attach-device", "detach-device"):
        return parts[1], parts[2], parts[3], None
    die(
        f"Unexpected SSH_ORIGINAL_COMMAND: {original!r}\n"
        f"Expected: ctrlable-build deploy <release> <template_name> <hostname>\n"
        f"      or: ctrlable-build preflight <release>\n"
        f"      or: ctrlable-build enable-internal-net <release> [ha_vmid]\n"
        f"      or: ctrlable-build migrate-internal <release> <template> <vmid>\n"
        f"      or: ctrlable-build update-host-tools\n"
        f"      or: ctrlable-build list-serial-devices\n"
        f"      or: ctrlable-build attach-device <vmid> <by-id>\n"
        f"      or: ctrlable-build detach-device <vmid> <by-id>"
    )


def load_conf() -> dict:
    path = Path("/etc/ctrlable/build.conf")
    if not path.exists():
        die(f"Missing config file: {path}")
    return json.loads(path.read_text())


# ---------------------------------------------------------------------------
# HTTP helpers (stdlib only)
# ---------------------------------------------------------------------------

def fetch_json(url: str, token: str) -> dict:
    req = urllib.request.Request(url, headers={"Authorization": f"Bearer {token}"})
    with urllib.request.urlopen(req, timeout=15) as resp:
        return json.loads(resp.read())


def fetch_text(url: str, token: str = "") -> str:
    headers = {"Authorization": f"Bearer {token}"} if token else {}
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=30) as resp:
        return resp.read().decode()


# ---------------------------------------------------------------------------
# PVE helpers
# ---------------------------------------------------------------------------

def next_vmid() -> int:
    return int(subprocess.run(
        ["pvesh", "get", "/cluster/nextid"],
        capture_output=True, text=True, check=True,
    ).stdout.strip())


def list_vmids() -> set[int]:
    lxc  = subprocess.run(["pct", "list"], capture_output=True, text=True, check=True).stdout
    qemu = subprocess.run(["qm",  "list"], capture_output=True, text=True, check=True).stdout
    ids: set[int] = set()
    for output in (lxc, qemu):
        for line in output.strip().splitlines()[1:]:
            parts = line.split()
            if parts:
                try:
                    ids.add(int(parts[0]))
                except ValueError:
                    pass
    return ids


def list_ct_vmids() -> set[int]:
    """Container VMIDs only — deliberately never VMs.

    deploy_lxc's fallback adopts the newest guest when a community script
    ignores our NEXTID; using the merged pct+qm list there let it adopt a VM.
    """
    out = subprocess.run(["pct", "list"], capture_output=True, text=True, check=True).stdout
    ids: set[int] = set()
    for line in out.strip().splitlines()[1:]:
        parts = line.split()
        if parts:
            try:
                ids.add(int(parts[0]))
            except ValueError:
                pass
    return ids


def detect_pve_storages() -> tuple[str, str]:
    """(container storage, template storage), picked by what each storage is
    configured to hold rather than by name: "local-lvm" only exists on ext4/xfs
    ISO installs, so ZFS hosts and Proxmox-on-Debian hosts had no valid default."""
    def active(content: str) -> list[tuple[str, str]]:
        out = subprocess.run(["pvesm", "status", "--content", content],
                             capture_output=True, text=True).stdout
        rows = [line.split() for line in out.strip().splitlines()[1:]]
        return [(r[0], r[1]) for r in rows if len(r) >= 3 and r[2] == "active"]

    rootdir = active("rootdir")
    container_st = next((n for n, k in rootdir if k in ("lvmthin", "zfspool", "lvm", "rbd")),
                        rootdir[0][0] if rootdir else "local-lvm")
    vztmpl = active("vztmpl")
    template_st = vztmpl[0][0] if vztmpl else "local"
    return container_st, template_st


def is_running(vmid: int) -> bool:
    result = subprocess.run(["pct", "status", str(vmid)], capture_output=True, text=True)
    return "running" in result.stdout


def pct_exec(vmid: int, *cmd: str) -> None:
    subprocess.run(["pct", "exec", str(vmid), "--"] + list(cmd), check=True)


def pct_push(vmid: int, src: str, dst: str) -> None:
    subprocess.run(["pct", "push", str(vmid), src, dst], check=True)


# ---------------------------------------------------------------------------
# Firstboot injection (LXC)
# ---------------------------------------------------------------------------

def inject_firstboot(vmid: int, name: str, manifest: dict, conf: dict,
                     firstboot_svc: str, firstboot_sh: str) -> None:
    log(f"[{name}] injecting ctrlable-firstboot")
    with tempfile.NamedTemporaryFile("w", suffix=".service", delete=False) as f:
        f.write(firstboot_svc)
        svc_tmp = f.name
    with tempfile.NamedTemporaryFile("w", suffix=".sh", delete=False) as f:
        f.write(firstboot_sh)
        sh_tmp = f.name

    try:
        pct_push(vmid, svc_tmp, "/etc/systemd/system/ctrlable-firstboot.service")
        pct_push(vmid, sh_tmp,  "/usr/local/bin/ctrlable-firstboot.sh")
        pct_exec(vmid, "chmod", "+x", "/usr/local/bin/ctrlable-firstboot.sh")
        pct_exec(vmid, "systemctl", "enable", "ctrlable-firstboot.service")
    finally:
        os.unlink(svc_tmp)
        os.unlink(sh_tmp)

    log(f"[{name}] writing /etc/ctrlable/firstboot.conf")
    firstboot_conf_data = json.dumps({
        "orchestrator_url": manifest.get("orchestrator_url", conf["orchestrator_url"]),
        "firstboot_secret": manifest.get("firstboot_secret", ""),
        "template_type":    name,
    }, indent=2)
    with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
        f.write(firstboot_conf_data)
        conf_tmp = f.name
    try:
        pct_exec(vmid, "mkdir", "-p", "/etc/ctrlable")
        pct_push(vmid, conf_tmp, "/etc/ctrlable/firstboot.conf")
        pct_exec(vmid, "chmod", "600", "/etc/ctrlable/firstboot.conf")
    finally:
        os.unlink(conf_tmp)

    # Run it NOW (after firstboot.conf exists). Guests are deployed directly --
    # no template + clone -- so the container's first boot has already
    # happened; enabled-only, the wiring waited for an unrelated reboot.
    pct_exec(vmid, "systemctl", "start", "--no-block", "ctrlable-firstboot.service")


def set_lxc_hostname(vmid: int, hostname: str) -> None:
    """Override hostname set by the community script to our naming convention."""
    subprocess.run(["pct", "set", str(vmid), "--hostname", hostname], check=True)
    pct_exec(vmid, "bash", "-c",
        f"echo '{hostname}' > /etc/hostname; "
        f"hostname '{hostname}'; "
        f"sed -i '/127\\.0\\.1\\.1/d' /etc/hosts; "
        f"echo '127.0.1.1 {hostname}' >> /etc/hosts"
    )


# ---------------------------------------------------------------------------
# LXC deploy
# ---------------------------------------------------------------------------

def build_env(tmpl: dict, conf: dict, vmid: int | None = None) -> dict:
    container_st = conf.get("container_storage") or None
    template_st  = conf.get("template_storage")  or None
    if not container_st or not template_st:
        _cs, _ts = detect_pve_storages()
        container_st = container_st or _cs
        template_st  = template_st  or _ts

    env = {
        **os.environ,
        "METHOD":                "default",
        "DEBIAN_FRONTEND":       "noninteractive",
        "TERM":                  "xterm",
        # SAY WE ARE NON-INTERACTIVE, in the words upstream reads.
        #
        # build.func asks questions. It gained a new one -- "an update for the
        # Proxmox LXC stack is available: [1] upgrade [2] ignore [3] cancel" --
        # and reads the answer with `read -rp ... </dev/tty`. This runs over
        # SSH with command=/no-pty and stdin at DEVNULL, so there is no
        # /dev/tty: the read failed, `set -u` then hit the unset $_ans, and
        # EVERY deploy died with "community script exited 1" on a host where
        # nothing had changed.
        #
        # Both of these are build.func's own unattended switches, checked
        # BEFORE that read (misc/build.func, the host-stack guard):
        #     if [[ "${PHS_SILENT:-0}" == "1" || "${_disable_update,,}" == "yes" ]]
        #         return 2      # "ignore, continue without upgrading"
        # DISABLE_UPDATE answers this prompt specifically; PHS_SILENT is the
        # general "do not ask me anything" flag, which is the only durable
        # answer when the question set is upstream's to change.
        #
        # Deliberately NOT option 1: a provisioning run must not apt-upgrade
        # someone's hypervisor as a side effect of creating a container.
        "DISABLE_UPDATE":        "yes",
        "PHS_SILENT":            "1",
        "mode":                  "1",
        "var_container_storage": container_st,
        "var_template_storage":  template_st,
        "IP":                    "",
    }
    # Ctrlable-owned builders (e.g. dali-bridge.sh) fetch their app source from a
    # private repo — pass the clone settings from build.conf so the builder sees
    # them (community-script builders ignore these).
    for key, cf in (("DALI_BRIDGE_REPO", "dali_bridge_repo"),
                    ("DALI_BRIDGE_REF",  "dali_bridge_ref"),
                    ("DALI_BRIDGE_SSH_KEY", "dali_bridge_ssh_key"),
                    ("DALI_BRIDGE_TOKEN", "dali_bridge_token"),
                    ("HW_MANAGER_REPO", "hw_manager_repo"),
                    ("HW_MANAGER_REF",  "hw_manager_ref"),
                    ("HW_MANAGER_SSH_KEY", "hw_manager_ssh_key"),
                    ("HW_MANAGER_TOKEN", "hw_manager_token")):
        if conf.get(cf):
            env[key] = str(conf[cf])
    # APP_VERSION is the manifest's own answer to "which release is this
    # template?", handed to the builder so it can clone that TAG rather than
    # whatever main happens to be.
    #
    # Without it the manifest's app_version was decorative: it said 0.1.0 while
    # the builder cloned main, so two appliances provisioned a week apart were
    # different software and the manifest documented neither. A release is a
    # thing you can point at or it is not a release.
    if tmpl.get("app_version"):
        env["APP_VERSION"] = str(tmpl["app_version"])
    # Pre-allocate VMID so parallel deploys don't collide.
    # Community scripts read NEXTID / CT_ID / CTID to pick the container ID.
    if vmid is not None:
        env["NEXTID"] = str(vmid)
        env["CT_ID"]  = str(vmid)
        env["CTID"]   = str(vmid)
    res  = tmpl.get("resources") or {}
    os_s = tmpl.get("os")        or {}
    if res.get("cpu"):              env["var_cpu"]               = str(res["cpu"])
    if res.get("ram"):              env["var_ram"]               = str(res["ram"])
    if res.get("disk"):             env["var_disk"]              = str(res["disk"])
    if os_s.get("distro"):          env["var_os"]                = os_s["distro"]
    if os_s.get("version"):         env["var_version"]           = str(os_s["version"])
    if tmpl.get("unprivileged") is not None:
        env["var_unprivileged"] = "1" if tmpl["unprivileged"] else "0"
    if tmpl.get("portainer"):       env["var_install_portainer"] = "yes"
    return env


def script_url(ref: str, builder: str) -> str:
    return f"https://raw.githubusercontent.com/community-scripts/ProxmoxVE/{ref}/{builder}"


CS_MAIN = "community-scripts/ProxmoxVE/main/"

# PIN THE WHOLE CHAIN, not just the per-app wrapper.
#
# ct/<app>.sh at our ref sources build.func from ProxmoxVE/main/misc/, and
# build.func, install.func and friends fetch every further piece from main/ as
# literal URLs -- including install.func's own fetches INSIDE the container. On
# 2026-10-31 upstream moved that engine to community-scripts/core and deleted
# misc/ from main ("Drop the legacy engine copies from misc/"), so every pinned
# script 404'd on its first line and then "succeeded" without creating anything.
#
# The wrappers below sit first on PATH for the community script. A request for
# ProxmoxVE/main/... goes to ProxmoxVE/<ref>/... instead, and the same string is
# rewritten inside what comes back -- so a file fetched from the ref points at
# the ref for ITS fetches too, and install.func carries the ref into the
# container in FUNCTIONS_FILE_PATH. Everything else passes through untouched.
_CS_WRAPPER = r"""#!/bin/bash
# ctrlable-build: pin community-scripts ProxmoxVE/main/ -> ProxmoxVE/@REF@/
real=$(PATH="${PATH#*:}" command -v @TOOL@)
pin=0; args=()
for a in "$@"; do
  if [[ "$a" == *community-scripts/ProxmoxVE/main/* ]]; then
    a="${a//community-scripts\/ProxmoxVE\/main\//community-scripts/ProxmoxVE/@REF@/}"; pin=1
  fi
  args+=("$a")
done
[[ $pin == 1 ]] || exec "$real" "$@"
out=""; prev=""
for a in "${args[@]}"; do
  case "$prev" in -o|-O|--output|--output-document) out="$a" ;; esac
  case "$a" in --output=*|--output-document=*) out="${a#*=}" ;; esac
  prev="$a"
done
rewrite() { sed 's#community-scripts/ProxmoxVE/main/#community-scripts/ProxmoxVE/@REF@/#g'; }
if [[ -n "$out" && "$out" != "-" ]]; then
  "$real" "${args[@]}" || exit $?
  if [[ -f "$out" ]]; then  # portable in-place (no GNU/BSD sed -i difference)
    t=$(mktemp); rewrite < "$out" > "$t" && cat "$t" > "$out"; rm -f "$t"
  fi
  exit 0
fi
set -o pipefail
"$real" "${args[@]}" | rewrite
"""


def cs_pin_dir(ref: str) -> str:
    """A temp dir holding curl/wget wrappers that pin ProxmoxVE/main/ to ref."""
    d = tempfile.mkdtemp(prefix="ctrlable-cs-pin-")
    for tool in ("curl", "wget"):
        path = os.path.join(d, tool)
        with open(path, "w") as fh:
            fh.write(_CS_WRAPPER.replace("@REF@", ref).replace("@TOOL@", tool))
        os.chmod(path, 0o755)
    return d


def pin_text(text: str, ref: str) -> str:
    return text.replace(CS_MAIN, f"community-scripts/ProxmoxVE/{ref}/")


def deploy_lxc(name: str, hostname: str, tmpl: dict, manifest: dict,
               firstboot_svc: str, firstboot_sh: str, conf: dict) -> int:
    ref     = manifest["community_scripts_ref"]
    builder = tmpl["builder"]
    vmid    = next_vmid()
    env     = build_env(tmpl, conf, vmid=vmid)
    cts_before = list_ct_vmids()

    if builder.startswith("ctrlable/"):
        # Ctrlable-owned builder (no community-script) — bundled on the build host.
        builders_dir = os.environ.get("CTRLABLE_BUILDERS_DIR", "/opt/ctrlable/builders")
        local = os.path.join(builders_dir, os.path.basename(builder))
        if not os.path.isfile(local):
            die(f"[{name}] bundled builder missing: {local}")
        log(f"[{name}] running ctrlable builder {local} (vmid={vmid}, host={hostname})")
        # Capture, don't discard: with stdout=DEVNULL a failed builder logged only
        # its exit code, which is no help with a deploy that died on site.
        result = subprocess.run(
            ["bash", local],
            env={**env, "VMID": str(vmid), "CT_HOSTNAME": hostname},
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        for line in result.stdout.decode(errors="replace").splitlines():
            clean = re.sub(r"\x1b\[[0-9;]*[a-zA-Z]", "", line).strip()
            if clean:
                log(f"[{name}] {clean[:300]}")
        if result.returncode != 0:
            die(f"[{name}] ctrlable builder exited {result.returncode}")
    else:
        url = script_url(ref, builder)
        phase(2, "downloading builder")
        log(f"[{name}] downloading builder: {url}")
        phase(3, "allocating vmid")
        log(f"[{name}] pre-allocated vmid={vmid}")
        phase(4, "running community script")
        log(f"[{name}] running community script (METHOD=default)")
        script = pin_text(fetch_text(url), ref)
        pin_dir = cs_pin_dir(ref)
        env = {**env, "PATH": f"{pin_dir}:{env.get('PATH', os.environ.get('PATH', ''))}"}
        # RUN FROM A FILE, NOT PIPED INTO `bash -s`.
        #
        # Piping puts the script text on stdin, so any `read` inside
        # community-scripts' build.func consumes the script's own remaining lines
        # instead of prompting. The script then executes a truncated version of
        # itself, exits 0, and creates nothing -- which surfaced as
        # "community script created no container, and none exist to adopt"
        # (2026-08-16, zwavejs). The identical script from a file, same env,
        # completed and built the container.
        #
        # stdin is /dev/null so a prompt fails fast rather than hanging a deploy.
        #
        # And CAPTURE the output. It was stdout=DEVNULL with stderr folded into
        # it, so every clue about why a build failed was discarded -- the log said
        # only that nothing had been created. These scripts are the part most
        # likely to break on a new PVE release; their output is exactly what is
        # needed when they do.
        with tempfile.NamedTemporaryFile("w", suffix=".sh", delete=False) as fh:
            fh.write(script)
            script_path = fh.name
        try:
            result = subprocess.run(["bash", script_path], env=env,
                                    stdin=subprocess.DEVNULL,
                                    stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        finally:
            os.unlink(script_path)
            shutil.rmtree(pin_dir, ignore_errors=True)
        out = result.stdout.decode(errors="replace")
        # Spinner frames are one line each and drown the real messages; keep the
        # lines that carry information.
        for line in out.splitlines():
            clean = re.sub(r"\x1b\[[0-9;]*[a-zA-Z]", "", line).strip()
            if clean and not re.match(r"^[\u2800-\u28ff\s]*$", clean):
                log(f"[{name}] {clean[:300]}")
        if result.returncode != 0:
            die(f"[{name}] community script exited {result.returncode}")

    # Verify the expected VMID was actually created
    if vmid not in list_ct_vmids():
        # The community script ignored our NEXTID. Recover by adopting the newest
        # container — but containers ONLY. list_vmids() merges pct and qm, and
        # taking max() across both adopted a freshly created VM during a full
        # stack deploy: the appliance VM had just taken vmid 100, so zwavejs ran
        # `pct start 100` against a QEMU guest and died with exit 255.
        # ONLY a container that appeared during THIS run. Taking "the newest
        # container" adopted whatever was built before: on 2026-11-03 freepbx's
        # script 404'd, created nothing, and freepbx then claimed the Frigate CT
        # built minutes earlier -- renamed it and overwrote its firstboot config.
        log(f"[{name}] WARNING: vmid={vmid} not found after script — detecting fallback")
        candidates = list_ct_vmids() - cts_before - {900}  # orchestrator excluded
        if not candidates:
            die(f"[{name}] community script created no container")
        if len(candidates) > 1:
            die(f"[{name}] community script created several containers {sorted(candidates)}; not guessing")
        vmid = candidates.pop()
    log(f"[{name}] container vmid={vmid}")

    # Ensure running so we can exec/push into it
    if not is_running(vmid):
        phase(5, "starting container")
        log(f"[{name}] starting container")
        subprocess.run(["pct", "start", str(vmid)], check=True)
    for _ in range(30):
        if is_running(vmid):
            break
        time.sleep(2)
    else:
        die(f"[{name}] container {vmid} did not start within 60s")

    phase(6, "configuring guest")
    log(f"[{name}] setting hostname to {hostname}")
    set_lxc_hostname(vmid, hostname)

    _add_internal_lxc_nic(vmid, name, manifest)

    inject_firstboot(vmid, name, manifest, conf, firstboot_svc, firstboot_sh)

    log(f"[RESULT] name={name} vmid={vmid} kind=lxc")
    return vmid


# ---------------------------------------------------------------------------
# VM deploy (ctrlable-pro / HAOS)
# ---------------------------------------------------------------------------

# The branded HAOS image lives in a PUBLIC GitHub release, so there is no reason
# a fresh host should need a 551MB file hand-copied onto it before it can build.
# It was documented as "ctrlable-build never downloads this", which made sense
# when the artefact was private; it is not, and the manual step was the last
# thing standing between a clean install and a working build (2026-08-16).
#
# Everything needed is already in the manifest: the template name is the brand
# ("ctrlable-pro"), haos_version is the tag. Both are overridable for a release
# that publishes somewhere else.
HAOS_IMAGE_REPO_DEFAULT = "Ctrlable/haos-base"
HAOS_IMAGE_DIR = "/opt/ctrlable/images"


def haos_image_url(name: str, tmpl: dict) -> tuple:
    """(url, filename) for a vm template's branded image, or ("", "")."""
    ver = str(tmpl.get("haos_version", "")).strip()
    if not ver:
        return "", ""
    repo = str(tmpl.get("haos_image_repo", HAOS_IMAGE_REPO_DEFAULT)).strip()
    asset = str(tmpl.get("haos_image_asset", "")).strip() or f"{name}-os-generic-x86-64-{ver}.img.xz"
    tag = str(tmpl.get("haos_image_tag", "")).strip() or f"haos-{ver}"
    return f"https://github.com/{repo}/releases/download/{tag}/{asset}", asset


def haos_image_available(url: str) -> bool:
    """Is the release asset actually fetchable? HEAD only -- preflight must not
    quietly pull half a gigabyte as a side effect of being run."""
    if not url:
        return False
    try:
        r = subprocess.run(["curl", "-sIL", "-o", "/dev/null", "-w", "%{http_code}",
                            "--max-time", "20", url], capture_output=True, text=True)
        return r.stdout.strip() == "200"
    except Exception:
        return False


def download_haos_image(url: str, asset: str) -> str:
    """Fetch to HAOS_IMAGE_DIR, atomically. Returns the path, or "" on failure."""
    os.makedirs(HAOS_IMAGE_DIR, exist_ok=True)
    dest = os.path.join(HAOS_IMAGE_DIR, asset)
    if os.path.exists(dest):
        return dest
    tmp = dest + ".part"
    log(f"[ctrlable-build] downloading {asset} ...")
    # -C - resumes a partial .part from an interrupted run rather than restarting
    # half a gigabyte. Written to .part and renamed only on success, so a killed
    # download can never be mistaken for a staged image by resolve_haos_image.
    r = subprocess.run(["curl", "-fL", "-C", "-", "--retry", "3", "-o", tmp, url])
    if r.returncode != 0:
        return ""
    if subprocess.run(["xz", "-t", tmp], capture_output=True).returncode != 0:
        log("[ctrlable-build] downloaded image failed xz -t — discarding")
        os.unlink(tmp)
        return ""
    os.rename(tmp, dest)
    return dest


def builder_credential(builder_path: str):
    """(deploy_key_path, build_conf_token_key) for a builder that clones private
    source, or None.

    Read out of the builder script itself -- it already declares its own default,
    e.g.  KEY="${DALI_BRIDGE_SSH_KEY:-/etc/ctrlable/dali-bridge-deploy-key}"
    -- so a new private builder needs no change here to be checked.
    """
    try:
        src = open(builder_path, encoding="utf-8", errors="replace").read()
    except OSError:
        return None
    m = re.search(r'KEY="\$\{[A-Z_]*SSH_KEY:-([^}"]+)\}"', src)
    if not m:
        return None
    key_path = m.group(1)
    # /etc/ctrlable/dali-bridge-deploy-key -> dali_bridge_token
    stem = os.path.basename(key_path).replace("-deploy-key", "").replace("-", "_")
    return key_path, f"{stem}_token"


def resolve_haos_image(conf: dict) -> str:
    """Path to the branded HAOS image this host will actually deploy, or "".

    Explicit haos_image_path wins. Otherwise fall back to the newest-looking
    .img/.img.xz in the usual directories — reverse-sorted, so a stray file can
    win. Preflight reports whichever this returns, so what it checks is exactly
    what deploy_vm will use.
    """
    path = conf.get("haos_image_path", "")
    if path:
        return path
    for d in ["/opt/ctrlable/images", "/var/lib/vz/template/iso"]:
        if os.path.isdir(d):
            for f in sorted(os.listdir(d), reverse=True):
                if f.endswith(".img.xz") or f.endswith(".img"):
                    return os.path.join(d, f)
    return ""


def preflight(release: str, manifest: dict, conf: dict) -> None:
    """Check that this host can actually deploy the release, and say why not.

    Deploys are direct — each one runs a community script or imports the staged
    HAOS image on the spot — so there is no build step that would surface a
    missing image or an unreachable builder early. Without this, the first sign
    of trouble is a half-created guest. Every check prints [CHECK] ok/FAIL and a
    non-zero exit marks the build record failed.
    """
    failures: list[str] = []

    def check(label: str, ok: bool, detail: str = "") -> None:
        log(f"[CHECK] {'ok  ' if ok else 'FAIL'} {label}{(' — ' + detail) if detail else ''}")
        if not ok:
            failures.append(label)

    log(f"[ctrlable-build] preflight release={release}")

    # --- which orchestrator is this, and what is it running -----------------
    #
    # Reported rather than checked: there is no wrong answer, only an unknown
    # one. It is here because this is the moment someone is asking "why did
    # this build produce that", and the orchestrator's own version was until
    # now unanswerable -- its tree is not reliably a git checkout, so there
    # was nothing in the container to interrogate.
    try:
        import urllib.request
        with urllib.request.urlopen(
                conf["orchestrator_url"].rstrip("/") + "/api/version",
                timeout=5) as r:
            v = json.loads(r.read().decode())
        log("[CHECK] ok   orchestrator %s (%s)%s"
            % (v.get("version", "?"), v.get("revision", "?"),
               (" — " + v["note"]) if v.get("note") else ""))
    except Exception as exc:                      # noqa: BLE001
        # Never a failure: an older orchestrator has no /api/version, and a
        # preflight that fails for lack of a version string would block a
        # perfectly good deploy.
        log("[CHECK] ok   orchestrator version not reported (%s)"
            % str(exc).split("\n")[0][:60])

    # --- host tooling ------------------------------------------------------
    # git is NOT part of a stock Proxmox install, and ctrlable-owned builders
    # clone their source at deploy time — a host without it fails mid-deploy.
    for tool in ("pct", "qm", "pvesh", "pvesm", "git"):
        found = subprocess.run(["sh", "-c", f"command -v {tool}"],
                               capture_output=True).returncode == 0
        check(f"tool {tool}", found, "" if found else "not on PATH")

    # --- storages ----------------------------------------------------------
    try:
        container_st, template_st = detect_pve_storages()
        check("pve storages", True, f"container={container_st} template={template_st}")
    except Exception as exc:
        check("pve storages", False, str(exc))

    templates = manifest.get("templates", {}) or {}
    vm_templates  = {n: t for n, t in templates.items() if t.get("kind") == "vm"}
    lxc_templates = {n: t for n, t in templates.items() if t.get("kind") != "vm"}

    # --- staged HAOS image -------------------------------------------------
    if vm_templates:
        image = resolve_haos_image(conf)
        exists = bool(image) and os.path.exists(image)
        if not exists:
            # Not staged is no longer fatal: if the release asset is reachable,
            # deploy will fetch it. Preflight only HEADs it -- pulling 551MB as a
            # side effect of a check would be a nasty surprise, and preflight is
            # run to find out whether a build CAN work, not to do half of it.
            for vname, vtmpl in vm_templates.items():
                url, asset = haos_image_url(vname, vtmpl)
                avail = haos_image_available(url)
                check(f"{vname} image available", avail,
                      (f"will download {asset}" if avail else
                       f"not staged and not fetchable: {url or 'no haos_version in manifest'}"))
        check("haos image staged", exists or True,
              image if exists else "not staged — will be downloaded at deploy")
        if exists:
            if image.endswith(".xz"):
                intact = subprocess.run(["xz", "-t", image], capture_output=True).returncode == 0
                check("haos image intact", intact, "xz -t" + ("" if intact else " failed — truncated download?"))
            # The manifest pin is advisory: deploy imports whatever is staged. A
            # mismatch here is the difference between shipping the OS you think
            # you pinned and silently shipping another one.
            for name, tmpl in vm_templates.items():
                want = str(tmpl.get("haos_version", "")).strip()
                if not want:
                    continue
                m = re.search(r"(\d+\.\d+(?:\.\d+)?)\.img(?:\.xz)?$", os.path.basename(image))
                got = m.group(1) if m else ""
                check(f"{name} image matches pin {want}", got == want,
                      f"staged image looks like {got or 'unknown version'} ({os.path.basename(image)})")

    # --- community-script builders reachable at the pinned ref -------------
    ref = manifest.get("community_scripts_ref", "")
    for name, tmpl in lxc_templates.items():
        builder = tmpl.get("builder", "")
        if not builder or builder.startswith("ctrlable/"):
            # ctrlable-owned builders are staged on this host, not fetched. Stat
            # the file — an earlier version only checked that a builder string
            # existed, so a host missing the script passed preflight and then
            # failed mid-deploy with "bundled builder missing".
            if not builder:
                check(f"{name} builder", False, "no builder set")
                continue
            builders_dir = os.environ.get("CTRLABLE_BUILDERS_DIR", "/opt/ctrlable/builders")
            local = os.path.join(builders_dir, os.path.basename(builder))
            present = os.path.isfile(local)
            check(f"{name} builder staged", present,
                  local if present else f"{local} missing — copy it from host/builders/")
            # Bundled builders clone private sources, so a staged script is not
            # enough — without a credential the deploy dies after the guest is
            # already being created.
            # Derived from the builder script, not hardcoded per name. This check
            # only ever covered dali-bridge, so hardware-manager -- which clones
            # an equally private repo via HW_MANAGER_SSH_KEY -- passed preflight
            # and then died mid-deploy, which is precisely the failure the check
            # exists to prevent. Any future private builder is now covered by
            # declaring its key the same way.
            cred = builder_credential(local)
            if cred:
                key_path, token_key = cred
                has_cred = os.path.isfile(key_path) or bool(conf.get(token_key))
                check(f"{name} source credential", has_cred,
                      key_path if os.path.isfile(key_path)
                      else f"no deploy key at {key_path} and no {token_key} in build.conf")
            continue
        url = script_url(ref, builder)
        try:
            req = urllib.request.Request(url, method="HEAD")
            with urllib.request.urlopen(req, timeout=15) as resp:
                ok = 200 <= resp.status < 300
            check(f"{name} builder @ {ref}", ok, url)
        except Exception as exc:
            check(f"{name} builder @ {ref}", False, f"{url} — {exc}")

    if failures:
        die(f"preflight failed: {len(failures)} check(s) — " + ", ".join(failures))
    log(f"[ctrlable-build] preflight passed — release {release} is deployable on this host")


# ---------------------------------------------------------------------------
# Internal management LAN (SPEC § 20) — a second NIC on vmbr1 with a fixed
# address, so inter-service wiring survives a site-LAN change. The manifest
# carries the plan (network.internal); here we attach each guest to it.
# ---------------------------------------------------------------------------

def _internal_net_cfg(manifest: dict,
                      conf_path: Path = Path("/etc/ctrlable/internal-net.conf")) -> dict | None:
    """The resolved internal-LAN config for this release, or None when absent/
    disabled. Mirrors backend/app/internal_net.py (ctrlable-build is standalone
    on the host and cannot import the backend)."""
    block = (manifest.get("network") or {}).get("internal")
    if not block or not block.get("enabled", True):
        return None
    subnet = str(block.get("subnet", "198.18.0.0/24"))
    bridge = str(block.get("bridge", "vmbr1"))
    # Honour host-chosen values: the bootstrap / enable writes these if the
    # manifest defaults collided with something already on the host — a used
    # subnet, or a vmbr1 that belongs to another network (then setup relocates
    # the internal LAN to the next free vmbrN and records it here).
    if conf_path.exists():
        for line in conf_path.read_text().splitlines():
            line = line.strip()
            if line.startswith("subnet="):
                subnet = line.split("=", 1)[1].strip() or subnet
            elif line.startswith("bridge="):
                bridge = line.split("=", 1)[1].strip() or bridge
    try:
        assignments = {k: int(v) for k, v in (block.get("assignments") or {}).items()}
    except (TypeError, ValueError):
        assignments = {}
    return {"bridge": bridge, "subnet": subnet, "assignments": assignments}


def _internal_ip(cfg: dict, template: str) -> str | None:
    """`<ip>/<prefix>` for a template within the internal subnet, or None."""
    octet = cfg["assignments"].get(template)
    if octet is None:
        return None
    net = ipaddress.ip_network(cfg["subnet"], strict=False)
    addr = net.network_address + int(octet)
    if addr not in net or addr == net.network_address:
        die(f"internal-net assignment {template}={octet} is outside {cfg['subnet']}")
    return f"{addr}/{net.prefixlen}"


def _bridge_exists(bridge: str) -> bool:
    return subprocess.run(["ip", "link", "show", bridge],
                          capture_output=True).returncode == 0


def _bridge_has_phys_member(bridge: str) -> bool:
    """True if <bridge> bridges a physical NIC (not a guest tap/veth or a PVE
    firewall iface). Mirrors _bridge_has_phys in setup-internal-net.sh."""
    brif = Path(f"/sys/class/net/{bridge}/brif")
    if not brif.is_dir():
        return False
    for m in brif.iterdir():
        if not m.name.startswith(("tap", "veth", "fwln", "fwpr", "fwbr")):
            return True
    return False


def _bridge_is_ours(bridge: str) -> bool:
    """True if <bridge> is the internal-LAN bridge (ours), not a foreign bridge
    such as a Wi-Fi uplink. Mirrors _bridge_usable in setup-internal-net.sh: the
    bridge must have no physical member and no non-internal (non-198.18/19) IPv4.
    A foreign bridge must never be used — we would otherwise attach guests to, or
    run DHCP onto, the customer's own network. SPEC § 20."""
    if not _bridge_exists(bridge):
        return False
    if _bridge_has_phys_member(bridge):
        return False
    out = subprocess.run(["ip", "-o", "-4", "addr", "show", "dev", bridge],
                         capture_output=True, text=True).stdout
    for line in out.splitlines():
        parts = line.split()
        if len(parts) >= 4 and parts[2] == "inet":
            a = parts[3]
            if not (a.startswith("198.18.") or a.startswith("198.19.")):
                return False
    return True


def _add_internal_lxc_nic(vmid: int, template: str, manifest: dict) -> None:
    """Give an LXC a STATIC net1 on the internal bridge (addressing.resolve reads
    it). No-op, with a clear log, when the release has no internal net or the
    bridge is not on this host yet."""
    cfg = _internal_net_cfg(manifest)
    if not cfg:
        return
    ipcidr = _internal_ip(cfg, template)
    if not ipcidr:
        log(f"[{template}] no internal-LAN assignment; skipping net1")
        return
    if not _bridge_exists(cfg["bridge"]):
        log(f"[{template}] {cfg['bridge']} absent on host; skipping internal net1 "
            f"(run the appliance bootstrap to create it)")
        return
    log(f"[{template}] internal LAN: net1 {ipcidr} on {cfg['bridge']}")
    subprocess.run(["pct", "set", str(vmid),
                    "-net1", f"name=eth1,bridge={cfg['bridge']},ip={ipcidr}"], check=True)


def _add_internal_vm_nic(vmid: int, template: str, manifest: dict) -> None:
    """Give the HAOS VM a net1 on the internal bridge and reserve its DHCP lease
    by MAC (HAOS cannot take a static IP from Proxmox, so it DHCPs here)."""
    cfg = _internal_net_cfg(manifest)
    if not cfg:
        return
    ipcidr = _internal_ip(cfg, template)
    if not ipcidr:
        return
    if not _bridge_exists(cfg["bridge"]):
        log(f"[{template}] {cfg['bridge']} absent on host; skipping internal net1")
        return
    ip = ipcidr.split("/")[0]
    subprocess.run(["qm", "set", str(vmid), "-net1", f"virtio,bridge={cfg['bridge']}"], check=True)
    cfgtxt = subprocess.run(["qm", "config", str(vmid)], capture_output=True, text=True).stdout
    mac = None
    for line in cfgtxt.splitlines():
        if line.startswith("net1:"):
            m = re.search(r"(?:virtio|macaddr)=([0-9A-Fa-f:]{17})", line)
            if m:
                mac = m.group(1)
    if not mac:
        log(f"[{template}] WARN: could not read net1 MAC; dnsmasq reservation skipped")
        return
    _dnsmasq_reserve(vmid, mac, ip)
    log(f"[{template}] internal LAN: VM net1 on {cfg['bridge']}; dnsmasq reserves {ip} for {mac}")


def _dnsmasq_reserve(vmid: int, mac: str, ip: str,
                     resv: Path = Path("/var/lib/misc/ctrlable-reservations")) -> None:
    """Reserve <ip> for <mac> in the dhcp-hostsfile the bootstrap configured.

    A dhcp-hostsfile (not a config drop-in) because dnsmasq re-reads it on
    `reload` — `dhcp-host=` in a config file is read ONLY at startup, so a
    reloaded reservation silently never takes effect (the guest gets a dynamic
    lease instead, caught in validation 2026-11-09). Upsert by internal IP (the
    slot) so a redeploy — which gives the VM a fresh MAC for the same address —
    replaces the owner instead of leaving two MACs reserved for one IP.
    """
    if not resv.parent.is_dir():
        log(f"[vmid {vmid}] {resv.parent} absent; internal reservation not written "
            f"(run the appliance bootstrap to set up dnsmasq)")
        return
    lines = [ln for ln in (resv.read_text().splitlines() if resv.exists() else [])
             if ln.strip() and ln.split(",")[-1].strip() != ip]
    lines.append(f"{mac},{ip}")
    resv.write_text("\n".join(lines) + "\n")
    resv.chmod(0o644)
    subprocess.run(["systemctl", "reload", "dnsmasq"], capture_output=True)


def _setup_script() -> str | None:
    """Locate the extracted host setup script (installed beside the host tools).
    install.sh keeps its own inline copy — see host/setup-internal-net.sh."""
    for p in ("/usr/local/lib/ctrlable/setup-internal-net.sh",
              str(Path(__file__).resolve().parent / "setup-internal-net.sh")):
        if os.path.exists(p):
            return p
    return None


def enable_internal_net(manifest: dict, conf: dict, ha_vmid: int | None) -> None:
    """Bring the internal management LAN up on an ALREADY-DEPLOYED host.

    New appliances get this at bootstrap (install.sh). This is the remote path
    for existing sites: create vmbr1 + dnsmasq (same script), then attach the
    HAOS VM so the broker lands on its reserved address. Idempotent. Existing
    guests are NOT re-wired here — that is a redeploy (which now adds net1) or a
    deliberate follow-up, so running this never disturbs a working service.
    The HA VM is NOT rebooted: net1 is hot-plugged and we only REPORT whether it
    came up, leaving the (brief, customer-visible) reboot an explicit decision.
    """
    cfg_m = _internal_net_cfg(manifest)
    if not cfg_m:
        die("this release declares no internal management LAN (network.internal)")

    # 1) fabric: the internal bridge + dnsmasq, via the one validated impl.
    script = _setup_script()
    if not script:
        die("setup-internal-net.sh not found on host; reinstall host tools "
            "(install_host_tools) then retry")
    # Pre-flight (read-only): note any vmbrN that already belongs to another
    # network, so the build log explains an upcoming relocation or skip up front.
    for b in ("vmbr1", "vmbr2", "vmbr3"):
        if _bridge_exists(b) and not _bridge_is_ours(b):
            log(f"[enable-internal-net] note: {b} already exists and is NOT the "
                f"internal LAN (physical port / non-internal address) — leaving "
                f"it alone")
    log("[enable-internal-net] creating bridge + dnsmasq")
    env = dict(os.environ)
    env["INTERNAL_SUBNET"] = cfg_m["subnet"]
    r = subprocess.run(["bash", script], env=env)
    if r.returncode != 0:
        die(f"setup-internal-net.sh failed (exit {r.returncode})")

    # Re-read cfg: the script may have chosen a fallback subnet (collision) and
    # written it to /etc/ctrlable/internal-net.conf, which _internal_net_cfg honours.
    cfg = _internal_net_cfg(manifest)
    bridge = cfg["bridge"]
    if not _bridge_exists(bridge):
        die(f"{bridge} is not up after setup; see 'journalctl -u dnsmasq' and "
            f"'/etc/network/interfaces.d/ctrlable-internal'")
    if not _bridge_is_ours(bridge):
        die(f"refusing to use {bridge}: it exists but belongs to another network "
            f"(it has a physical port or a non-internal address — e.g. a Wi-Fi "
            f"uplink). setup-internal-net.sh relocates to a free vmbrN; if every "
            f"vmbr1..3 is taken, free one (or set INTERNAL_SUBNET) and retry. No "
            f"guest was attached.")
    log(f"[enable-internal-net] fabric up: {bridge} on {cfg['subnet']}")

    # 2) attach the HAOS VM so the broker is reachable at its reserved address.
    broker_ipcidr = _internal_ip(cfg, BROKER_TEMPLATE)
    broker_ip = broker_ipcidr.split("/")[0] if broker_ipcidr else None
    if ha_vmid is None:
        log("[enable-internal-net] no HA vmid supplied; fabric is up but the "
            "broker VM was not attached — pass the ctrlable-pro vmid to finish")
        return

    existing_mac = _vm_net1_mac_on(ha_vmid, bridge)
    if existing_mac:
        log(f"[enable-internal-net] VM {ha_vmid} already has net1 on {bridge} "
            f"({existing_mac}); ensuring reservation only")
        _dnsmasq_reserve(ha_vmid, existing_mac, broker_ip)
    else:
        _add_internal_vm_nic(ha_vmid, BROKER_TEMPLATE, manifest)

    # 3) report whether the hot-plugged NIC came up on the reserved address.
    if broker_ip and _wait_reachable(broker_ip, 30):
        log(f"[enable-internal-net] OK: broker reachable at {broker_ip} on {bridge}")
    else:
        log(f"[enable-internal-net] net1 attached + reserved for {broker_ip}, but "
            f"it is not answering yet. HAOS usually DHCPs a hot-plugged NIC within "
            f"a minute; if it does not, reboot VM {ha_vmid} to pick it up.")


# ---------------------------------------------------------------------------
# migrate-internal — move an ALREADY-DEPLOYED service onto the internal LAN in
# place (no redeploy): attach its net1, then re-home its app wiring.
#
# The re-homing is NOT uniform. A service that CONNECTS OUT to the broker
# (zigbee2mqtt -> MQTT) has its own config rewritten here and is restarted. A
# service that Home Assistant CONNECTS IN TO (zwave-js, frigate) only needs the
# NIC on this side — the integration URL is changed on the HA VM, so we attach
# the NIC and report the endpoint rather than guess at HA's .storage.
# ---------------------------------------------------------------------------
_MIGRATORS = {
    "zigbee2mqtt": {"kind": "broker_client", "unit": "zigbee2mqtt",
                    "config": "/opt/zigbee2mqtt/data/configuration.yaml"},
    "zwavejs":     {"kind": "ha_served", "port": 3000, "what": "Home Assistant's Z-Wave JS integration"},
    "frigate":     {"kind": "ha_served", "port": 5000, "what": "Home Assistant's Frigate integration"},
    "freepbx":     {"kind": "ha_served", "port": None,  "what": "the PBX / intercom configuration"},
}


def _lxc_net1_on(vmid: int, bridge: str) -> bool:
    """True if the LXC already has a net1 on <bridge> (migrate is idempotent)."""
    out = subprocess.run(["pct", "config", str(vmid)], capture_output=True, text=True).stdout
    for line in out.splitlines():
        if line.startswith("net1:") and f"bridge={bridge}" in line:
            return True
    return False


def _pct_exec(vmid: int, script: str, timeout: int = 90):
    return subprocess.run(["pct", "exec", str(vmid), "--", "bash", "-lc", script],
                          capture_output=True, text=True, timeout=timeout)


def migrate_internal(manifest: dict, conf: dict, template: str, vmid: int) -> None:
    """Re-home a running LXC service onto the internal LAN. Idempotent."""
    cfg = _internal_net_cfg(manifest)
    if not cfg:
        die("this release declares no internal management LAN (network.internal)")
    if template == BROKER_TEMPLATE:
        die(f"{template} is the broker (the hub of the internal LAN), not a service to migrate")
    bridge = cfg["bridge"]
    if not _bridge_exists(bridge):
        die(f"{bridge} is not up on this host — run 'enable-internal-net' first")
    if not _bridge_is_ours(bridge):
        die(f"{bridge} exists but is not the internal LAN bridge; refusing to touch it")
    ipcidr = _internal_ip(cfg, template)
    if not ipcidr:
        die(f"no internal-LAN assignment for template {template!r} in this release")
    ip = ipcidr.split("/")[0]
    broker_ipcidr = _internal_ip(cfg, BROKER_TEMPLATE)
    broker_ip = broker_ipcidr.split("/")[0] if broker_ipcidr else None

    tmpl = (manifest.get("templates") or {}).get(template, {})
    if tmpl.get("kind", "lxc") == "vm":
        die(f"{template} is a VM, not an LXC; migrate-internal handles LXC services")

    log(f"[migrate-internal] {template} (vmid {vmid}) -> {ip} on {bridge}")

    # 1) attach net1 (idempotent; never touches net0 / the site LAN)
    if _lxc_net1_on(vmid, bridge):
        log(f"[migrate-internal] net1 already on {bridge}; keeping it")
    else:
        subprocess.run(["pct", "set", str(vmid),
                        "-net1", f"name=eth1,bridge={bridge},ip={ipcidr}"], check=True)
        log(f"[migrate-internal] attached net1 {ipcidr} (eth1)")
        time.sleep(2)

    # 2) the container really has the internal address
    probe = _pct_exec(vmid, "ip -br -4 addr show eth1 2>/dev/null")
    if ip not in probe.stdout:
        die(f"[migrate-internal] eth1 did not come up with {ip} inside vmid {vmid} "
            f"(got: {probe.stdout.strip() or 'nothing'})")
    log(f"[migrate-internal] eth1 up inside container: {probe.stdout.strip()}")

    m = _MIGRATORS.get(template)
    if not m:
        log(f"[migrate-internal] no app migrator for {template!r}; NIC attached only")
        log(f"[migrate-internal] OK: {template} is on the internal LAN at {ip} (NIC only)")
        return

    if m["kind"] == "ha_served":
        where = f"{ip}:{m['port']}" if m.get("port") else ip
        log(f"[migrate-internal] {template} is reached BY Home Assistant, not the other way")
        log(f"[migrate-internal] point {m['what']} at {where}, then it survives a site move")
        log(f"[migrate-internal] OK: {template} is on the internal LAN at {ip} (NIC attached; HA-side URL change pending)")
        return

    # broker_client: prove the broker is reachable, then re-home + restart
    if broker_ip:
        r = _pct_exec(vmid, f"timeout 3 bash -c 'echo > /dev/tcp/{broker_ip}/1883' 2>/dev/null && echo OPEN || echo CLOSED")
        if "OPEN" not in r.stdout:
            die(f"[migrate-internal] broker {broker_ip}:1883 not reachable from the container — "
                f"is the internal LAN enabled and the broker VM up?")
        log(f"[migrate-internal] broker {broker_ip}:1883 reachable from the container")

    unit, cfgfile, target = m["unit"], m["config"], f"mqtt://{broker_ip}:1883"
    script = (
        f'set -e; f="{cfgfile}"; '
        f'[ -f "$f" ] || {{ echo "NOCONFIG:$f"; exit 3; }}; '
        f'if grep -q "server: {target}" "$f"; then echo ALREADY; exit 0; fi; '
        f'cp -a "$f" "$f.bak-$(date +%Y%m%d-%H%M%S)"; '
        f'sed -i -E "s#(server:[[:space:]]*mqtt://)[^[:space:]]+#\\1{broker_ip}:1883#" "$f"; '
        f'systemctl restart {unit}; echo REWROTE'
    )
    rr = _pct_exec(vmid, script)
    if rr.returncode != 0:
        die(f"[migrate-internal] rewrite/restart of {unit} failed "
            f"(exit {rr.returncode}): {rr.stdout.strip()} {rr.stderr.strip()}")
    if "ALREADY" in rr.stdout:
        log(f"[migrate-internal] {unit} already points at {broker_ip}; nothing to change")
        log(f"[migrate-internal] OK: {template} already re-homed to the broker at {broker_ip}")
        return
    log(f"[migrate-internal] {unit}: mqtt.server -> {target}, service restarted")

    # 3) confirm it reconnected to the broker over the internal LAN
    time.sleep(8)
    vlog = _pct_exec(vmid, f"journalctl -u {unit} -n 50 --no-pager 2>/dev/null | "
                           f"grep -iE 'connected to mqtt|not authorized|econnrefused|error' | tail -4")
    if vlog.stdout.strip():
        log(f"[migrate-internal] {unit} log:\n{vlog.stdout.strip()}")
    if "Connected to MQTT" in vlog.stdout:
        log(f"[migrate-internal] OK: {template} reconnected to the broker at {broker_ip}")
    else:
        log(f"[migrate-internal] {template} re-homed and restarted; the MQTT reconnect is not "
            f"confirmed in the log yet — check 'journalctl -u {unit}' shortly")


def _orchestrator_ctid(conf: dict) -> int:
    """The LXC id of the orchestrator (where the repo lives), to pull host tools
    from. From build.conf, else discovered by finding the CT that has the repo."""
    cid = conf.get("orchestrator_ctid")
    if cid:
        return int(cid)
    # Fallback for hosts whose build.conf predates orchestrator_ctid: find the CT
    # carrying the provisioner checkout.
    out = subprocess.run(["pct", "list"], capture_output=True, text=True).stdout
    for line in out.splitlines()[1:]:
        ctid = line.split()[0] if line.split() else ""
        if ctid.isdigit() and subprocess.run(
                ["pct", "exec", ctid, "--", "test", "-f",
                 "/opt/ctrlable-provisioner/host/ctrlable-build"]).returncode == 0:
            return int(ctid)
    die("could not find the orchestrator LXC (set orchestrator_ctid in build.conf)")


# What `update-host-tools` syncs from the orchestrator's repo onto the host.
# (src inside the CT, dst on the host, mode). Keep in step with install.sh's
# install_host_tools.
_HOST_TOOL_FILES = [
    ("/opt/ctrlable-provisioner/host/ctrlable-build", "/usr/local/bin/ctrlable-build", 0o755),
    ("/opt/ctrlable-provisioner/host/setup-internal-net.sh",
     "/usr/local/lib/ctrlable/setup-internal-net.sh", 0o755),
]
_HOST_BUILDERS_SRC = "/opt/ctrlable-provisioner/host/builders"
_HOST_BUILDERS_DST = "/opt/ctrlable/builders"


def _pct_pull_atomic(ctid: int, src: str, dst: str, mode: int) -> None:
    """Pull one file out of the CT and move it into place atomically — never
    write over a live file in place (an in-flight run would see a mix)."""
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    tmp = f"{dst}.new-{os.getpid()}"
    r = subprocess.run(["pct", "pull", str(ctid), src, tmp], capture_output=True, text=True)
    if r.returncode != 0 or not os.path.exists(tmp) or os.path.getsize(tmp) == 0:
        # pct pull exits 0 on a missing file and leaves an empty one (known trap).
        if os.path.exists(tmp):
            os.unlink(tmp)
        die(f"could not pull {src} from CT {ctid}: {r.stderr.strip() or 'empty/missing'}")
    os.chmod(tmp, mode)
    os.replace(tmp, dst)   # atomic within the same filesystem
    log(f"[update-host-tools] {dst}")


def update_host_tools(conf: dict) -> None:
    """Refresh the host-side tools (this script + the internal-net setup +
    builders) from the orchestrator's freshly-updated checkout. Runs as part of
    a provisioner self-update so the host never lags the orchestrator."""
    ctid = _orchestrator_ctid(conf)
    log(f"[update-host-tools] syncing host tools from CT {ctid}")
    for src, dst, mode in _HOST_TOOL_FILES:
        _pct_pull_atomic(ctid, src, dst, mode)
    # Builders: pull each file the CT lists (names only; a path would let the CT
    # choose the host destination).
    listing = subprocess.run(
        ["pct", "exec", str(ctid), "--", "ls", "-1", _HOST_BUILDERS_SRC],
        capture_output=True, text=True).stdout
    for name in listing.split():
        name = os.path.basename(name.strip())
        if name:
            _pct_pull_atomic(ctid, f"{_HOST_BUILDERS_SRC}/{name}",
                             f"{_HOST_BUILDERS_DST}/{name}", 0o755)
    log("[update-host-tools] done")


def _vm_net1_mac_on(vmid: int, bridge: str) -> str | None:
    """MAC of an existing net1 already on <bridge>, or None (so enable is idempotent)."""
    out = subprocess.run(["qm", "config", str(vmid)], capture_output=True, text=True).stdout
    for line in out.splitlines():
        if line.startswith("net1:") and f"bridge={bridge}" in line:
            m = re.search(r"(?:virtio|macaddr)=([0-9A-Fa-f:]{17})", line)
            return m.group(1) if m else None
    return None


def _wait_reachable(ip: str, secs: int) -> bool:
    deadline = time.time() + secs
    while time.time() < deadline:
        if subprocess.run(["ping", "-c1", "-W1", ip], capture_output=True).returncode == 0:
            return True
        time.sleep(2)
    return False


def deploy_vm(name: str, hostname: str, tmpl: dict, manifest: dict, conf: dict) -> int:
    phase(2, "allocating vmid")
    vmid = next_vmid()
    container_st = conf.get("container_storage") or detect_pve_storages()[0]

    haos_image_path = resolve_haos_image(conf)
    if not haos_image_path or not os.path.exists(haos_image_path):
        # Fetch on demand rather than failing with "stage this by hand".
        url, asset = haos_image_url(name, tmpl)
        if url:
            haos_image_path = download_haos_image(url, asset)

    if not haos_image_path or not os.path.exists(haos_image_path):
        die(
            f"[{name}] branded HAOS image not found.\n"
            f"  Set 'haos_image_path' in /etc/ctrlable/build.conf or copy the .img.xz to\n"
            f"  /opt/ctrlable/images/"
        )

    log(f"[{name}] deploying VM vmid={vmid} from image: {haos_image_path}")
    res   = tmpl.get("resources") or {}
    cores = str(res.get("cpu",  2))
    mem   = str(res.get("ram",  4096))
    disk  = str(res.get("disk", 32))

    temp_raw_path: str | None = None
    try:
        if haos_image_path.endswith(".xz"):
            temp_raw_path = os.path.join(
                os.path.dirname(haos_image_path), f"ctrlable-haos-{vmid}.img"
            )
            phase(3, "decompressing image")
            log(f"[{name}] decompressing image to {temp_raw_path} ...")
            with open(temp_raw_path, "wb") as fout:
                subprocess.run(
                    ["xz", "--decompress", "--stdout", haos_image_path],
                    stdout=fout, check=True,
                )
            raw_img = temp_raw_path
        else:
            raw_img = haos_image_path

        phase(4, "creating VM")
        log(f"[{name}] creating VM")
        subprocess.run([
            "qm", "create", str(vmid),
            "--name",     hostname,
            "--memory",   mem,
            "--cores",    cores,
            "--cpu",      "host",
            "--machine",  "q35",
            "--bios",     "ovmf",
            "--efidisk0", f"{container_st}:0,efitype=4m,pre-enrolled-keys=0",
            "--net0",     "virtio,bridge=vmbr0",
            "--ostype",   "l26",
            "--tablet",   "0",
            "--balloon",  "0",
        ], check=True)

        _add_internal_vm_nic(vmid, name, manifest)

        phase(5, "importing disk")
        log(f"[{name}] importing disk")
        subprocess.run(
            ["qm", "importdisk", str(vmid), raw_img, container_st, "--format", "qcow2"],
            check=True,
        )

        cfg = subprocess.run(
            ["qm", "config", str(vmid)], capture_output=True, text=True, check=True
        ).stdout
        disk_ref = None
        for line in cfg.splitlines():
            if line.startswith("unused"):
                disk_ref = line.split(":", 1)[1].strip()
                break
        if not disk_ref:
            die(f"[{name}] could not find imported disk after importdisk")

        log(f"[{name}] attaching disk {disk_ref}")
        subprocess.run([
            "qm", "set", str(vmid),
            "--scsihw", "virtio-scsi-pci",
            "--scsi0",  f"{disk_ref},discard=on,iothread=1",
            "--boot",   "order=scsi0",
        ], check=True)

        log(f"[{name}] resizing disk to {disk}G")
        subprocess.run(
            ["qm", "disk", "resize", str(vmid), "scsi0", f"{disk}G"],
            check=True,
        )

        phase(6, "starting VM")
        log(f"[{name}] starting VM")
        subprocess.run(["qm", "start", str(vmid)], check=True)

    finally:
        if temp_raw_path:
            try:
                os.unlink(temp_raw_path)
                log(f"[{name}] removed temp image {temp_raw_path}")
            except FileNotFoundError:
                pass

    log(f"[RESULT] name={name} vmid={vmid} kind=qemu")
    return vmid


# ---------------------------------------------------------------------------
# USB serial device passthrough (LXC)
#
# Assign Zigbee / Z-Wave / Thread USB sticks to a service LXC by their STABLE
# /dev/serial/by-id handle, never the ephemeral ttyUSB*/ttyACM* name (which
# renumbers on replug/reboot). The raw lxc.* lines written here mirror
# backend/app/devices.py:lxc_passthrough_lines (unit-tested there) — keep the two
# in sync. The PVE API does not accept raw lxc.* keys, which is why this lives in
# the host wrapper. VM USB passthrough is a different path (usbN via the API).
# ---------------------------------------------------------------------------

import stat as _stat  # noqa: E402

BYID_DIR = "/dev/serial/by-id"
_BYID_RE = re.compile(r"^[A-Za-z0-9._:+-]+$")   # by-id basenames only — never a path


def _lxc_conf_path(vmid: int) -> Path:
    return Path(f"/etc/pve/lxc/{vmid}.conf")


def _require_lxc(vmid: int) -> Path:
    p = _lxc_conf_path(vmid)
    if p.exists():
        return p
    if Path(f"/etc/pve/qemu-server/{vmid}.conf").exists():
        die(f"vmid {vmid} is a VM; USB serial passthrough here is LXC-only "
            f"(VM USB goes through the Proxmox API, not this path)")
    die(f"no LXC {vmid} on this host")


def _validate_byid(by_id: str) -> None:
    if not by_id or "/" in by_id or not _BYID_RE.match(by_id):
        die(f"invalid device id {by_id!r}")


def _byid_node(by_id: str) -> tuple[str, int, int] | None:
    """(node, major, minor) for a present by-id stick, or None if unplugged."""
    link = os.path.join(BYID_DIR, by_id)
    if not os.path.exists(link):
        return None
    node = os.path.realpath(link)
    try:
        st = os.stat(node)
    except OSError:
        return None
    if not _stat.S_ISCHR(st.st_mode):
        die(f"{node} is not a character device")
    return node, os.major(st.st_rdev), os.minor(st.st_rdev)


def _udev_props(node: str) -> dict:
    try:
        out = subprocess.run(["udevadm", "info", "--query=property", f"--name={node}"],
                             capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return {}
    props: dict = {}
    for line in out.splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            props[k] = v
    return props


def _byid_bindings() -> dict:
    """by-id -> {'vmid', 'kind'} for every LXC that currently binds it."""
    out: dict = {}
    base = Path("/etc/pve/lxc")
    if not base.is_dir():
        return out
    for conf in base.glob("*.conf"):
        try:
            vmid = int(conf.stem)
        except ValueError:
            continue
        try:
            text = conf.read_text()
        except OSError:
            continue
        for raw in text.splitlines():
            m = re.match(r"^\s*lxc\.mount\.entry\s*[:=]\s*(\S+)", raw)
            if m and m.group(1).startswith(BYID_DIR + "/"):
                out[m.group(1)[len(BYID_DIR) + 1:]] = {"vmid": vmid, "kind": "lxc"}
                continue
            # PVE-native devN passthrough ("dev0: /dev/serial/by-id/<id>,gid=20"):
            # PVE expands it to a mount only at CT start, so it is never stored as
            # an lxc.mount.entry -- miss it and an in-use coordinator reads as free
            # and can be double-bound. MUST match devices.py:parse_pve_dev_passthrough.
            d = re.match(r"^\s*dev\d+\s*[:=]\s*(\S+)", raw)
            if d:
                dev_path = d.group(1).split(",", 1)[0]
                if dev_path.startswith(BYID_DIR + "/"):
                    out[dev_path[len(BYID_DIR) + 1:]] = {"vmid": vmid, "kind": "pve-dev"}
    return out


def _passthrough_lines(by_id: str, major: int, minor: int) -> list[str]:
    # MUST match backend/app/devices.py:lxc_passthrough_lines.
    src = f"{BYID_DIR}/{by_id}"
    return [
        f"lxc.cgroup2.devices.allow: c {major}:{minor} rwm",
        f"lxc.mount.entry: {src} dev/serial/by-id/{by_id} none bind,optional,create=file 0 0",
    ]


def _write_conf_lines(path: Path, lines: list[str]) -> None:
    tmp = path.with_name(path.name + ".ctrlable-tmp")
    tmp.write_text("\n".join(lines) + "\n")
    os.replace(tmp, path)   # atomic within pmxcfs


def list_serial_devices() -> None:
    """Emit JSON (sole stdout) for every /dev/serial/by-id stick: stable id,
    serial, current node + major:minor, by-path (port), vendor/product, and which
    LXC binds it. Read-only — safe to run anytime."""
    bindings = _byid_bindings()
    devices = []
    if os.path.isdir(BYID_DIR):
        for by_id in sorted(os.listdir(BYID_DIR)):
            resolved = _byid_node(by_id)
            node = resolved[0] if resolved else None
            major = resolved[1] if resolved else None
            minor = resolved[2] if resolved else None
            props = _udev_props(node) if node else {}
            devices.append({
                "by_id": by_id,
                "serial": props.get("ID_SERIAL_SHORT"),
                "node": node,
                "major": major, "minor": minor,
                "by_path": props.get("ID_PATH"),
                "vendor_id": props.get("ID_VENDOR_ID"),
                "product_id": props.get("ID_MODEL_ID"),
                "vendor": props.get("ID_VENDOR_FROM_DATABASE") or props.get("ID_VENDOR"),
                "product": props.get("ID_MODEL_FROM_DATABASE") or props.get("ID_MODEL"),
                "bound_to": bindings.get(by_id),
            })
    print(json.dumps({"devices": devices}))


def attach_serial_device(vmid: int, by_id: str) -> None:
    _validate_byid(by_id)
    path = _require_lxc(vmid)
    resolved = _byid_node(by_id)
    if not resolved:
        die(f"device {by_id!r} is not present under {BYID_DIR} — plug it in first")
    node, major, minor = resolved
    lines = path.read_text().splitlines()
    want = _passthrough_lines(by_id, major, minor)
    existing = {l.strip() for l in lines}
    to_add = [w for w in want if w not in existing]
    if not to_add:
        log(f"[attach-device] {by_id} already bound to LXC {vmid}")
        log(f"[attach-device] OK: {by_id} on {vmid} (no change)")
        return
    _write_conf_lines(path, lines + to_add)
    log(f"[attach-device] bound {by_id} (node {node}, {major}:{minor}) to LXC {vmid}")
    log(f"[attach-device] RESTART REQUIRED: the bind mount takes effect when CT {vmid} next starts")
    log(f"[attach-device] OK: {by_id} attached to {vmid}")


def detach_serial_device(vmid: int, by_id: str) -> None:
    _validate_byid(by_id)
    path = _require_lxc(vmid)
    src = f"{BYID_DIR}/{by_id}"
    # Drop this device's cgroup-allow line too, but only if the stick is still
    # present so we know its major:minor (mirrors devices.detach_plan). If it is
    # unplugged we remove just the bind mount and leave the benign allow rule.
    allow_val = None
    resolved = _byid_node(by_id)
    if resolved:
        allow_val = f"c {resolved[1]}:{resolved[2]} rwm"
    kept, dropped = [], 0
    for raw in path.read_text().splitlines():
        m = re.match(r"^\s*lxc\.mount\.entry\s*[:=]\s*(\S+)", raw)
        if m and m.group(1) == src:
            dropped += 1
            continue
        if allow_val is not None:
            a = re.match(r"^\s*lxc\.cgroup2\.devices\.allow\s*[:=]\s*(.+?)\s*$", raw)
            if a and a.group(1).strip() == allow_val:
                dropped += 1
                continue
        kept.append(raw)
    if dropped == 0:
        log(f"[detach-device] {by_id} was not bound to LXC {vmid}")
        log(f"[detach-device] OK: {by_id} not on {vmid} (no change)")
        return
    _write_conf_lines(path, kept)
    log(f"[detach-device] removed {by_id} from LXC {vmid} ({dropped} line(s))")
    log(f"[detach-device] RESTART REQUIRED: the unbind takes effect when CT {vmid} next starts")
    log(f"[detach-device] OK: {by_id} detached from {vmid}")


