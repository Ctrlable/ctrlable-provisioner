#!/usr/bin/env python3
"""
ctrlable-build — runs on the PVE host, invoked via SSH command= restriction.

authorized_keys entry:
  command="/usr/local/bin/ctrlable-build",restrict,no-pty ssh-rsa AAAA...

SSH_ORIGINAL_COMMAND format:
  ctrlable-build deploy <release> <template_name> <hostname>

Deploys a single instance directly (no templates, no clone):
  - LXC: runs the community script, injects firstboot service, leaves running
  - VM:  imports the branded HAOS .img.xz, configures, starts

Config file /etc/ctrlable/build.conf (JSON):
  {
    "orchestrator_url": "http://<ip>:8000",
    "build_token": "<same as BUILD_TOKEN in orchestrator .env>",
    "haos_image_path": "/opt/ctrlable/images/ctrlable-pro-os-generic-x86-64-<ver>.img.xz"
  }
"""

import json
import os
import re
import subprocess
import sys
import tempfile
import time
import urllib.request
from pathlib import Path


# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

def log(msg: str) -> None:
    print(msg, flush=True)


def die(msg: str) -> None:
    log(f"[ERROR] {msg}")
    sys.exit(1)


# Deploys are long and mostly silent (a 551 MB decompress, then a community
# script that prints its own spinner). The orchestrator parses these markers to
# drive a progress bar, so the count must stay honest: emit every phase exactly
# once, in order, and keep the total equal to the number a path really has.
PHASE_TOTAL = 6


def phase(n: int, label: str) -> None:
    log(f"[PHASE] {n}/{PHASE_TOTAL} {label}")


# ---------------------------------------------------------------------------
# Args + config
# ---------------------------------------------------------------------------

def parse_args() -> tuple[str, str, str | None, str | None]:
    """Return (action, release, template_name, hostname) from SSH_ORIGINAL_COMMAND."""
    original = os.environ.get("SSH_ORIGINAL_COMMAND", "")
    parts = original.split()
    if len(parts) == 5 and parts[0] == "ctrlable-build" and parts[1] == "deploy":
        return "deploy", parts[2], parts[3], parts[4]
    if len(parts) == 3 and parts[0] == "ctrlable-build" and parts[1] == "preflight":
        return "preflight", parts[2], None, None
    die(
        f"Unexpected SSH_ORIGINAL_COMMAND: {original!r}\n"
        f"Expected: ctrlable-build deploy <release> <template_name> <hostname>\n"
        f"      or: ctrlable-build preflight <release>"
    )


def load_conf() -> dict:
    path = Path("/etc/ctrlable/build.conf")
    if not path.exists():
        die(f"Missing config file: {path}")
    return json.loads(path.read_text())


# ---------------------------------------------------------------------------
# HTTP helpers (stdlib only)
# ---------------------------------------------------------------------------

def fetch_json(url: str, token: str) -> dict:
    req = urllib.request.Request(url, headers={"Authorization": f"Bearer {token}"})
    with urllib.request.urlopen(req, timeout=15) as resp:
        return json.loads(resp.read())


def fetch_text(url: str, token: str = "") -> str:
    headers = {"Authorization": f"Bearer {token}"} if token else {}
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=30) as resp:
        return resp.read().decode()


# ---------------------------------------------------------------------------
# PVE helpers
# ---------------------------------------------------------------------------

def next_vmid() -> int:
    return int(subprocess.run(
        ["pvesh", "get", "/cluster/nextid"],
        capture_output=True, text=True, check=True,
    ).stdout.strip())


def list_vmids() -> set[int]:
    lxc  = subprocess.run(["pct", "list"], capture_output=True, text=True, check=True).stdout
    qemu = subprocess.run(["qm",  "list"], capture_output=True, text=True, check=True).stdout
    ids: set[int] = set()
    for output in (lxc, qemu):
        for line in output.strip().splitlines()[1:]:
            parts = line.split()
            if parts:
                try:
                    ids.add(int(parts[0]))
                except ValueError:
                    pass
    return ids


def list_ct_vmids() -> set[int]:
    """Container VMIDs only — deliberately never VMs.

    deploy_lxc's fallback adopts the newest guest when a community script
    ignores our NEXTID; using the merged pct+qm list there let it adopt a VM.
    """
    out = subprocess.run(["pct", "list"], capture_output=True, text=True, check=True).stdout
    ids: set[int] = set()
    for line in out.strip().splitlines()[1:]:
        parts = line.split()
        if parts:
            try:
                ids.add(int(parts[0]))
            except ValueError:
                pass
    return ids


def detect_pve_storages() -> tuple[str, str]:
    out = subprocess.run(["pvesm", "status"], capture_output=True, text=True).stdout
    container_st = "local-lvm"
    template_st  = "local"
    for line in out.strip().splitlines()[1:]:
        parts = line.split()
        if len(parts) < 3:
            continue
        name, kind, status = parts[0], parts[1], parts[2]
        if status != "active":
            continue
        if kind in ("lvmthin", "lvm", "zfspool") and container_st == "local-lvm":
            container_st = name
        if kind == "dir" and template_st == "local":
            template_st = name
    return container_st, template_st


def is_running(vmid: int) -> bool:
    result = subprocess.run(["pct", "status", str(vmid)], capture_output=True, text=True)
    return "running" in result.stdout


def pct_exec(vmid: int, *cmd: str) -> None:
    subprocess.run(["pct", "exec", str(vmid), "--"] + list(cmd), check=True)


def pct_push(vmid: int, src: str, dst: str) -> None:
    subprocess.run(["pct", "push", str(vmid), src, dst], check=True)


# ---------------------------------------------------------------------------
# Firstboot injection (LXC)
# ---------------------------------------------------------------------------

def inject_firstboot(vmid: int, name: str, manifest: dict, conf: dict,
                     firstboot_svc: str, firstboot_sh: str) -> None:
    log(f"[{name}] injecting ctrlable-firstboot")
    with tempfile.NamedTemporaryFile("w", suffix=".service", delete=False) as f:
        f.write(firstboot_svc)
        svc_tmp = f.name
    with tempfile.NamedTemporaryFile("w", suffix=".sh", delete=False) as f:
        f.write(firstboot_sh)
        sh_tmp = f.name

    try:
        pct_push(vmid, svc_tmp, "/etc/systemd/system/ctrlable-firstboot.service")
        pct_push(vmid, sh_tmp,  "/usr/local/bin/ctrlable-firstboot.sh")
        pct_exec(vmid, "chmod", "+x", "/usr/local/bin/ctrlable-firstboot.sh")
        pct_exec(vmid, "systemctl", "enable", "ctrlable-firstboot.service")
    finally:
        os.unlink(svc_tmp)
        os.unlink(sh_tmp)

    log(f"[{name}] writing /etc/ctrlable/firstboot.conf")
    firstboot_conf_data = json.dumps({
        "orchestrator_url": manifest.get("orchestrator_url", conf["orchestrator_url"]),
        "firstboot_secret": manifest.get("firstboot_secret", ""),
        "template_type":    name,
    }, indent=2)
    with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
        f.write(firstboot_conf_data)
        conf_tmp = f.name
    try:
        pct_exec(vmid, "mkdir", "-p", "/etc/ctrlable")
        pct_push(vmid, conf_tmp, "/etc/ctrlable/firstboot.conf")
        pct_exec(vmid, "chmod", "600", "/etc/ctrlable/firstboot.conf")
    finally:
        os.unlink(conf_tmp)


def set_lxc_hostname(vmid: int, hostname: str) -> None:
    """Override hostname set by the community script to our naming convention."""
    subprocess.run(["pct", "set", str(vmid), "--hostname", hostname], check=True)
    pct_exec(vmid, "bash", "-c",
        f"echo '{hostname}' > /etc/hostname; "
        f"hostname '{hostname}'; "
        f"sed -i '/127\\.0\\.1\\.1/d' /etc/hosts; "
        f"echo '127.0.1.1 {hostname}' >> /etc/hosts"
    )


# ---------------------------------------------------------------------------
# LXC deploy
# ---------------------------------------------------------------------------

def build_env(tmpl: dict, conf: dict, vmid: int | None = None) -> dict:
    container_st = conf.get("container_storage") or None
    template_st  = conf.get("template_storage")  or None
    if not container_st or not template_st:
        _cs, _ts = detect_pve_storages()
        container_st = container_st or _cs
        template_st  = template_st  or _ts

    env = {
        **os.environ,
        "METHOD":                "default",
        "DEBIAN_FRONTEND":       "noninteractive",
        "TERM":                  "xterm",
        "mode":                  "1",
        "var_container_storage": container_st,
        "var_template_storage":  template_st,
        "IP":                    "",
    }
    # Ctrlable-owned builders (e.g. dali-bridge.sh) fetch their app source from a
    # private repo — pass the clone settings from build.conf so the builder sees
    # them (community-script builders ignore these).
    for key, cf in (("DALI_BRIDGE_REPO", "dali_bridge_repo"),
                    ("DALI_BRIDGE_REF",  "dali_bridge_ref"),
                    ("DALI_BRIDGE_SSH_KEY", "dali_bridge_ssh_key"),
                    ("DALI_BRIDGE_TOKEN", "dali_bridge_token")):
        if conf.get(cf):
            env[key] = str(conf[cf])
    # Pre-allocate VMID so parallel deploys don't collide.
    # Community scripts read NEXTID / CT_ID / CTID to pick the container ID.
    if vmid is not None:
        env["NEXTID"] = str(vmid)
        env["CT_ID"]  = str(vmid)
        env["CTID"]   = str(vmid)
    res  = tmpl.get("resources") or {}
    os_s = tmpl.get("os")        or {}
    if res.get("cpu"):              env["var_cpu"]               = str(res["cpu"])
    if res.get("ram"):              env["var_ram"]               = str(res["ram"])
    if res.get("disk"):             env["var_disk"]              = str(res["disk"])
    if os_s.get("distro"):          env["var_os"]                = os_s["distro"]
    if os_s.get("version"):         env["var_version"]           = str(os_s["version"])
    if tmpl.get("unprivileged") is not None:
        env["var_unprivileged"] = "1" if tmpl["unprivileged"] else "0"
    if tmpl.get("portainer"):       env["var_install_portainer"] = "yes"
    return env


def script_url(ref: str, builder: str) -> str:
    return f"https://raw.githubusercontent.com/community-scripts/ProxmoxVE/{ref}/{builder}"


def deploy_lxc(name: str, hostname: str, tmpl: dict, manifest: dict,
               firstboot_svc: str, firstboot_sh: str, conf: dict) -> int:
    ref     = manifest["community_scripts_ref"]
    builder = tmpl["builder"]
    vmid    = next_vmid()
    env     = build_env(tmpl, conf, vmid=vmid)

    if builder.startswith("ctrlable/"):
        # Ctrlable-owned builder (no community-script) — bundled on the build host.
        builders_dir = os.environ.get("CTRLABLE_BUILDERS_DIR", "/opt/ctrlable/builders")
        local = os.path.join(builders_dir, os.path.basename(builder))
        if not os.path.isfile(local):
            die(f"[{name}] bundled builder missing: {local}")
        log(f"[{name}] running ctrlable builder {local} (vmid={vmid}, host={hostname})")
        result = subprocess.run(
            ["bash", local],
            env={**env, "VMID": str(vmid), "CT_HOSTNAME": hostname},
            stdout=subprocess.DEVNULL, stderr=subprocess.STDOUT)
        if result.returncode != 0:
            die(f"[{name}] ctrlable builder exited {result.returncode}")
    else:
        url = script_url(ref, builder)
        phase(2, "downloading builder")
        log(f"[{name}] downloading builder: {url}")
        phase(3, "allocating vmid")
        log(f"[{name}] pre-allocated vmid={vmid}")
        phase(4, "running community script")
        log(f"[{name}] running community script (METHOD=default)")
        script = fetch_text(url)
        result = subprocess.run(["bash", "-s"], input=script.encode(), env=env,
                                stdout=subprocess.DEVNULL, stderr=subprocess.STDOUT)
        if result.returncode != 0:
            die(f"[{name}] community script exited {result.returncode}")

    # Verify the expected VMID was actually created
    if vmid not in list_ct_vmids():
        # The community script ignored our NEXTID. Recover by adopting the newest
        # container — but containers ONLY. list_vmids() merges pct and qm, and
        # taking max() across both adopted a freshly created VM during a full
        # stack deploy: the appliance VM had just taken vmid 100, so zwavejs ran
        # `pct start 100` against a QEMU guest and died with exit 255.
        log(f"[{name}] WARNING: vmid={vmid} not found after script — detecting fallback")
        candidates = list_ct_vmids() - {900}  # orchestrator excluded
        if not candidates:
            die(f"[{name}] community script created no container, and none exist to adopt")
        vmid = max(candidates)
    log(f"[{name}] container vmid={vmid}")

    # Ensure running so we can exec/push into it
    if not is_running(vmid):
        phase(5, "starting container")
        log(f"[{name}] starting container")
        subprocess.run(["pct", "start", str(vmid)], check=True)
    for _ in range(30):
        if is_running(vmid):
            break
        time.sleep(2)
    else:
        die(f"[{name}] container {vmid} did not start within 60s")

    phase(6, "configuring guest")
    log(f"[{name}] setting hostname to {hostname}")
    set_lxc_hostname(vmid, hostname)

    inject_firstboot(vmid, name, manifest, conf, firstboot_svc, firstboot_sh)

    log(f"[RESULT] name={name} vmid={vmid} kind=lxc")
    return vmid


# ---------------------------------------------------------------------------
# VM deploy (ctrlable-pro / HAOS)
# ---------------------------------------------------------------------------

# The branded HAOS image lives in a PUBLIC GitHub release, so there is no reason
# a fresh host should need a 551MB file hand-copied onto it before it can build.
# It was documented as "ctrlable-build never downloads this", which made sense
# when the artefact was private; it is not, and the manual step was the last
# thing standing between a clean install and a working build (2026-08-16).
#
# Everything needed is already in the manifest: the template name is the brand
# ("ctrlable-pro"), haos_version is the tag. Both are overridable for a release
# that publishes somewhere else.
HAOS_IMAGE_REPO_DEFAULT = "Ctrlable/haos-base"
HAOS_IMAGE_DIR = "/opt/ctrlable/images"


def haos_image_url(name: str, tmpl: dict) -> tuple:
    """(url, filename) for a vm template's branded image, or ("", "")."""
    ver = str(tmpl.get("haos_version", "")).strip()
    if not ver:
        return "", ""
    repo = str(tmpl.get("haos_image_repo", HAOS_IMAGE_REPO_DEFAULT)).strip()
    asset = str(tmpl.get("haos_image_asset", "")).strip() or f"{name}-os-generic-x86-64-{ver}.img.xz"
    tag = str(tmpl.get("haos_image_tag", "")).strip() or f"haos-{ver}"
    return f"https://github.com/{repo}/releases/download/{tag}/{asset}", asset


def haos_image_available(url: str) -> bool:
    """Is the release asset actually fetchable? HEAD only -- preflight must not
    quietly pull half a gigabyte as a side effect of being run."""
    if not url:
        return False
    try:
        r = subprocess.run(["curl", "-sIL", "-o", "/dev/null", "-w", "%{http_code}",
                            "--max-time", "20", url], capture_output=True, text=True)
        return r.stdout.strip() == "200"
    except Exception:
        return False


def download_haos_image(url: str, asset: str) -> str:
    """Fetch to HAOS_IMAGE_DIR, atomically. Returns the path, or "" on failure."""
    os.makedirs(HAOS_IMAGE_DIR, exist_ok=True)
    dest = os.path.join(HAOS_IMAGE_DIR, asset)
    if os.path.exists(dest):
        return dest
    tmp = dest + ".part"
    log(f"[ctrlable-build] downloading {asset} ...")
    # -C - resumes a partial .part from an interrupted run rather than restarting
    # half a gigabyte. Written to .part and renamed only on success, so a killed
    # download can never be mistaken for a staged image by resolve_haos_image.
    r = subprocess.run(["curl", "-fL", "-C", "-", "--retry", "3", "-o", tmp, url])
    if r.returncode != 0:
        return ""
    if subprocess.run(["xz", "-t", tmp], capture_output=True).returncode != 0:
        log("[ctrlable-build] downloaded image failed xz -t — discarding")
        os.unlink(tmp)
        return ""
    os.rename(tmp, dest)
    return dest


def builder_credential(builder_path: str):
    """(deploy_key_path, build_conf_token_key) for a builder that clones private
    source, or None.

    Read out of the builder script itself -- it already declares its own default,
    e.g.  KEY="${DALI_BRIDGE_SSH_KEY:-/etc/ctrlable/dali-bridge-deploy-key}"
    -- so a new private builder needs no change here to be checked.
    """
    try:
        src = open(builder_path, encoding="utf-8", errors="replace").read()
    except OSError:
        return None
    m = re.search(r'KEY="\$\{[A-Z_]*SSH_KEY:-([^}"]+)\}"', src)
    if not m:
        return None
    key_path = m.group(1)
    # /etc/ctrlable/dali-bridge-deploy-key -> dali_bridge_token
    stem = os.path.basename(key_path).replace("-deploy-key", "").replace("-", "_")
    return key_path, f"{stem}_token"


def resolve_haos_image(conf: dict) -> str:
    """Path to the branded HAOS image this host will actually deploy, or "".

    Explicit haos_image_path wins. Otherwise fall back to the newest-looking
    .img/.img.xz in the usual directories — reverse-sorted, so a stray file can
    win. Preflight reports whichever this returns, so what it checks is exactly
    what deploy_vm will use.
    """
    path = conf.get("haos_image_path", "")
    if path:
        return path
    for d in ["/opt/ctrlable/images", "/var/lib/vz/template/iso"]:
        if os.path.isdir(d):
            for f in sorted(os.listdir(d), reverse=True):
                if f.endswith(".img.xz") or f.endswith(".img"):
                    return os.path.join(d, f)
    return ""


def preflight(release: str, manifest: dict, conf: dict) -> None:
    """Check that this host can actually deploy the release, and say why not.

    Deploys are direct — each one runs a community script or imports the staged
    HAOS image on the spot — so there is no build step that would surface a
    missing image or an unreachable builder early. Without this, the first sign
    of trouble is a half-created guest. Every check prints [CHECK] ok/FAIL and a
    non-zero exit marks the build record failed.
    """
    failures: list[str] = []

    def check(label: str, ok: bool, detail: str = "") -> None:
        log(f"[CHECK] {'ok  ' if ok else 'FAIL'} {label}{(' — ' + detail) if detail else ''}")
        if not ok:
            failures.append(label)

    log(f"[ctrlable-build] preflight release={release}")

    # --- host tooling ------------------------------------------------------
    # git is NOT part of a stock Proxmox install, and ctrlable-owned builders
    # clone their source at deploy time — a host without it fails mid-deploy.
    for tool in ("pct", "qm", "pvesh", "pvesm", "git"):
        found = subprocess.run(["sh", "-c", f"command -v {tool}"],
                               capture_output=True).returncode == 0
        check(f"tool {tool}", found, "" if found else "not on PATH")

    # --- storages ----------------------------------------------------------
    try:
        container_st, template_st = detect_pve_storages()
        check("pve storages", True, f"container={container_st} template={template_st}")
    except Exception as exc:
        check("pve storages", False, str(exc))

    templates = manifest.get("templates", {}) or {}
    vm_templates  = {n: t for n, t in templates.items() if t.get("kind") == "vm"}
    lxc_templates = {n: t for n, t in templates.items() if t.get("kind") != "vm"}

    # --- staged HAOS image -------------------------------------------------
    if vm_templates:
        image = resolve_haos_image(conf)
        exists = bool(image) and os.path.exists(image)
        if not exists:
            # Not staged is no longer fatal: if the release asset is reachable,
            # deploy will fetch it. Preflight only HEADs it -- pulling 551MB as a
            # side effect of a check would be a nasty surprise, and preflight is
            # run to find out whether a build CAN work, not to do half of it.
            for vname, vtmpl in vm_templates.items():
                url, asset = haos_image_url(vname, vtmpl)
                avail = haos_image_available(url)
                check(f"{vname} image available", avail,
                      (f"will download {asset}" if avail else
                       f"not staged and not fetchable: {url or 'no haos_version in manifest'}"))
        check("haos image staged", exists or True,
              image if exists else "not staged — will be downloaded at deploy")
        if exists:
            if image.endswith(".xz"):
                intact = subprocess.run(["xz", "-t", image], capture_output=True).returncode == 0
                check("haos image intact", intact, "xz -t" + ("" if intact else " failed — truncated download?"))
            # The manifest pin is advisory: deploy imports whatever is staged. A
            # mismatch here is the difference between shipping the OS you think
            # you pinned and silently shipping another one.
            for name, tmpl in vm_templates.items():
                want = str(tmpl.get("haos_version", "")).strip()
                if not want:
                    continue
                m = re.search(r"(\d+\.\d+(?:\.\d+)?)\.img(?:\.xz)?$", os.path.basename(image))
                got = m.group(1) if m else ""
                check(f"{name} image matches pin {want}", got == want,
                      f"staged image looks like {got or 'unknown version'} ({os.path.basename(image)})")

    # --- community-script builders reachable at the pinned ref -------------
    ref = manifest.get("community_scripts_ref", "")
    for name, tmpl in lxc_templates.items():
        builder = tmpl.get("builder", "")
        if not builder or builder.startswith("ctrlable/"):
            # ctrlable-owned builders are staged on this host, not fetched. Stat
            # the file — an earlier version only checked that a builder string
            # existed, so a host missing the script passed preflight and then
            # failed mid-deploy with "bundled builder missing".
            if not builder:
                check(f"{name} builder", False, "no builder set")
                continue
            builders_dir = os.environ.get("CTRLABLE_BUILDERS_DIR", "/opt/ctrlable/builders")
            local = os.path.join(builders_dir, os.path.basename(builder))
            present = os.path.isfile(local)
            check(f"{name} builder staged", present,
                  local if present else f"{local} missing — copy it from host/builders/")
            # Bundled builders clone private sources, so a staged script is not
            # enough — without a credential the deploy dies after the guest is
            # already being created.
            # Derived from the builder script, not hardcoded per name. This check
            # only ever covered dali-bridge, so hardware-manager -- which clones
            # an equally private repo via HW_MANAGER_SSH_KEY -- passed preflight
            # and then died mid-deploy, which is precisely the failure the check
            # exists to prevent. Any future private builder is now covered by
            # declaring its key the same way.
            cred = builder_credential(local)
            if cred:
                key_path, token_key = cred
                has_cred = os.path.isfile(key_path) or bool(conf.get(token_key))
                check(f"{name} source credential", has_cred,
                      key_path if os.path.isfile(key_path)
                      else f"no deploy key at {key_path} and no {token_key} in build.conf")
            continue
        url = script_url(ref, builder)
        try:
            req = urllib.request.Request(url, method="HEAD")
            with urllib.request.urlopen(req, timeout=15) as resp:
                ok = 200 <= resp.status < 300
            check(f"{name} builder @ {ref}", ok, url)
        except Exception as exc:
            check(f"{name} builder @ {ref}", False, f"{url} — {exc}")

    if failures:
        die(f"preflight failed: {len(failures)} check(s) — " + ", ".join(failures))
    log(f"[ctrlable-build] preflight passed — release {release} is deployable on this host")


def deploy_vm(name: str, hostname: str, tmpl: dict, manifest: dict, conf: dict) -> int:
    phase(2, "allocating vmid")
    vmid = next_vmid()
    container_st, _ = detect_pve_storages()

    haos_image_path = resolve_haos_image(conf)
    if not haos_image_path or not os.path.exists(haos_image_path):
        # Fetch on demand rather than failing with "stage this by hand".
        url, asset = haos_image_url(name, tmpl)
        if url:
            haos_image_path = download_haos_image(url, asset)

    if not haos_image_path or not os.path.exists(haos_image_path):
        die(
            f"[{name}] branded HAOS image not found.\n"
            f"  Set 'haos_image_path' in /etc/ctrlable/build.conf or copy the .img.xz to\n"
            f"  /opt/ctrlable/images/"
        )

    log(f"[{name}] deploying VM vmid={vmid} from image: {haos_image_path}")
    res   = tmpl.get("resources") or {}
    cores = str(res.get("cpu",  2))
    mem   = str(res.get("ram",  4096))
    disk  = str(res.get("disk", 32))

    temp_raw_path: str | None = None
    try:
        if haos_image_path.endswith(".xz"):
            temp_raw_path = os.path.join(
                os.path.dirname(haos_image_path), f"ctrlable-haos-{vmid}.img"
            )
            phase(3, "decompressing image")
            log(f"[{name}] decompressing image to {temp_raw_path} ...")
            with open(temp_raw_path, "wb") as fout:
                subprocess.run(
                    ["xz", "--decompress", "--stdout", haos_image_path],
                    stdout=fout, check=True,
                )
            raw_img = temp_raw_path
        else:
            raw_img = haos_image_path

        phase(4, "creating VM")
        log(f"[{name}] creating VM")
        subprocess.run([
            "qm", "create", str(vmid),
            "--name",     hostname,
            "--memory",   mem,
            "--cores",    cores,
            "--cpu",      "host",
            "--machine",  "q35",
            "--bios",     "ovmf",
            "--efidisk0", f"{container_st}:0,efitype=4m,pre-enrolled-keys=0",
            "--net0",     "virtio,bridge=vmbr0",
            "--ostype",   "l26",
            "--tablet",   "0",
            "--balloon",  "0",
        ], check=True)

        phase(5, "importing disk")
        log(f"[{name}] importing disk")
        subprocess.run(
            ["qm", "importdisk", str(vmid), raw_img, container_st, "--format", "qcow2"],
            check=True,
        )

        cfg = subprocess.run(
            ["qm", "config", str(vmid)], capture_output=True, text=True, check=True
        ).stdout
        disk_ref = None
        for line in cfg.splitlines():
            if line.startswith("unused"):
                disk_ref = line.split(":", 1)[1].strip()
                break
        if not disk_ref:
            die(f"[{name}] could not find imported disk after importdisk")

        log(f"[{name}] attaching disk {disk_ref}")
        subprocess.run([
            "qm", "set", str(vmid),
            "--scsihw", "virtio-scsi-pci",
            "--scsi0",  f"{disk_ref},discard=on,iothread=1",
            "--boot",   "order=scsi0",
        ], check=True)

        log(f"[{name}] resizing disk to {disk}G")
        subprocess.run(
            ["qm", "disk", "resize", str(vmid), "scsi0", f"{disk}G"],
            check=True,
        )

        phase(6, "starting VM")
        log(f"[{name}] starting VM")
        subprocess.run(["qm", "start", str(vmid)], check=True)

    finally:
        if temp_raw_path:
            try:
                os.unlink(temp_raw_path)
                log(f"[{name}] removed temp image {temp_raw_path}")
            except FileNotFoundError:
                pass

    log(f"[RESULT] name={name} vmid={vmid} kind=qemu")
    return vmid


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main() -> None:
    action, release, template_name, hostname = parse_args()
    conf     = load_conf()
    base_url = conf["orchestrator_url"].rstrip("/")
    token    = conf["build_token"]

    if action == "deploy":
        log(f"[ctrlable-build] deploy release={release} name={template_name} hostname={hostname}")

    if action == "deploy":
        phase(1, "fetching manifest")
    manifest_url = f"{base_url}/api/releases/{release}/manifest?token={token}"
    log(f"fetching manifest: {manifest_url}")
    try:
        manifest = fetch_json(manifest_url, token)
    except Exception as exc:
        die(f"could not fetch manifest: {exc}")

    if action == "preflight":
        preflight(release, manifest, conf)
        return

    templates = manifest.get("templates", {})
    if template_name not in templates:
        die(f"template {template_name!r} not found in release {release!r}")
    tmpl = templates[template_name]
    kind = tmpl.get("kind", "lxc")

    if kind == "vm":
        deploy_vm(template_name, hostname, tmpl, manifest, conf)
    else:
        try:
            firstboot_sh  = fetch_text(f"{base_url}/api/provision/firstboot-script?token={token}", token)
            firstboot_svc = fetch_text(f"{base_url}/api/provision/firstboot-service-unit?token={token}", token)
        except Exception as exc:
            die(f"could not fetch firstboot assets: {exc}")
        deploy_lxc(template_name, hostname, tmpl, manifest, firstboot_svc, firstboot_sh, conf)


if __name__ == "__main__":
    main()
